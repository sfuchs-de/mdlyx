exports[`golden fixtures > 005-macros.md > exports to LaTeX deterministically (golden) 1`] = `
"\\documentclass{article}
\\usepackage{amsmath}
\\usepackage{amssymb}
\\usepackage{hyperref}
\\newcommand{\\RR}{\\mathbb{R}}
\\newcommand{\\dd}{\\,\\mathrm{d}}
\\numberwithin{equation}{section}
\\begin{document}

\\section{Macros and numbering}

We work over $\\RR$ throughout.

\\begin{equation}
\\int_\\RR f(x)\\dd x
\\label{eq:intR}
\\end{equation}

\\end{document}
"
`;

exports[`golden fixtures > 005-macros.md > serializes deterministically (golden) 1`] = `
"---
macros:
  RR: "\\mathbb{R}"
  dd: "\\,\\mathrm{d}"
numbering:
  equations: section
---

# Macros and numbering

We work over $\\RR$ throughout.

$$
\\int_\\RR f(x)\\dd x
$$ {#eq:intR}
"
`;

exports[`golden fixtures > 006-broken-latex.md > exports to LaTeX deterministically (golden) 1`] = `
"\\documentclass{article}
\\usepackage{amsmath}
\\usepackage{amssymb}
\\usepackage{hyperref}
\\begin{document}

\\section{Broken LaTeX}

Inline with an unbalanced brace $\\frac{a}{$ should not crash anything.

\\begin{equation}
\\begin{cases} x \\\\ y
\\label{eq:broken}
\\end{equation}

Text continues normally after the broken block.

\\end{document}
"
`;

exports[`golden fixtures > 006-broken-latex.md > serializes deterministically (golden) 1`] = `
