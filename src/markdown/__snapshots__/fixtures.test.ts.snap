exports[`golden fixtures > 007-mixed.md > exports to LaTeX deterministically (golden) 1`] = `
"\\documentclass{article}
\\usepackage{amsmath}
\\usepackage{amssymb}
\\usepackage{hyperref}
\\begin{document}

\\section{Mixed document}
\\label{sec:intro}

A paragraph with \\textbf{bold}, \\emph{italic}, \\texttt{code}, a \\href{https://ex.com}{link}, and
inline math $x_n = x_{n-1} + 1$.

\\begin{equation}
S = \\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}
\\label{eq:basel}
\\end{equation}

See Equation~\\eqref{eq:basel}.

\\begin{itemize}
  \\item a list item
  \\item another with math $\\alpha$
\\end{itemize}

\\begin{quote}
A quote containing $\\beta$.
\\end{quote}

\\begin{verbatim}
print("hello")
\\end{verbatim}

\\end{document}
"
`;

exports[`golden fixtures > 007-mixed.md > serializes deterministically (golden) 1`] = `
"# Mixed document {#sec:intro}

A paragraph with **bold**, *italic*, \`code\`, a [link](https://ex.com), and
inline math $x_n = x_{n-1} + 1$.

$$
S = \\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}
$$ {#eq:basel}

See @eq:basel.

- a list item
- another with math $\\alpha$

> A quote containing $\\beta$.

\`\`\`python
print("hello")
\`\`\`
"
`;

exports[`golden fixtures > 008-tables-rules.md > exports to LaTeX deterministically (golden) 1`] = `
"\\documentclass{article}
\\usepackage{amsmath}
\\usepackage{amssymb}
\\usepackage{hyperref}
\\begin{document}

\\section{Tables and rules}

A small table with math and formatting in cells:

\\begin{tabular}{lll}
\\hline
Symbol & Meaning & Value \\\\
\\hline
$\\alpha$ & \\textbf{growth} rate & $0.1$ \\\\
$\\beta$ & \\emph{decay} with a \\texttt{pipe} & $-0.15$ \\\\
\\hline
\\end{tabular}

\\par\\noindent\\rule{\\linewidth}{0.4pt}\\par

Text after a horizontal rule.

\\begin{tabular}{ll}
\\hline
A & B \\\\
\\hline
1 & 2 \\\\
\\hline
\\end{tabular}

\\end{document}
"
`;

exports[`golden fixtures > 008-tables-rules.md > serializes deterministically (golden) 1`] = `
"# Tables and rules

A small table with math and formatting in cells:

| Symbol | Meaning | Value |
| --- | --- | --- |
| $\\alpha$ | **growth** rate | $0.1$ |
| $\\beta$ | *decay* with a \`pipe\` | $-0.15$ |

---

