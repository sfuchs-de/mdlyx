{
  "name": "mdlyx",
  "private": false,
  "version": "0.1.5",
  "description": "A local-first, Markdown-native mathematical research editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfuchs-de/mdlyx.git"
  },
  "homepage": "https://github.com/sfuchs-de/mdlyx",
  "bugs": {
    "url": "https://github.com/sfuchs-de/mdlyx/issues"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/require-node-22.mjs",
    "pretypecheck": "node scripts/require-node-22.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run build:api",
    "prebuild": "node scripts/require-node-22.mjs",
    "build": "tsc && vite build",
    "prebuild:tauri": "node scripts/require-node-22.mjs",
    "build:tauri": "tsc && vite build --mode tauri",
    "prebuild:api": "node scripts/require-node-22.mjs",
    "build:api": "tsc -p tsconfig.server.json",
    "prestart:api": "node scripts/require-node-22.mjs",
    "start:api": "node dist-server/index.js",
    "prepreview": "node scripts/require-node-22.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/require-node-22.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/require-node-22.mjs",
    "test:watch": "vitest",
    "pree2e": "node scripts/require-node-22.mjs",
    "e2e": "playwright test",
    "pree2e:chromium": "node scripts/require-node-22.mjs",
    "e2e:chromium": "playwright test --project=chromium",
    "pree2e:webkit": "node scripts/require-node-22.mjs",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:install": "playwright install chromium webkit",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "preaudit:overview": "node scripts/require-node-22.mjs",
    "audit:overview": "tsx scripts/audit-project-overview.ts",
    "prelibrary:init": "node scripts/require-node-22.mjs",
    "library:init": "tsx scripts/init-library.ts",
    "prelibrary:validate": "node scripts/require-node-22.mjs",
    "library:validate": "tsx scripts/validate-library.ts",
    "predocs:check": "node scripts/require-node-22.mjs",
    "docs:check": "tsx scripts/check-docs.ts",
    "privacy:check": "node scripts/privacy-check.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "mathlive": "0.110.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.42.2",
    "redis": "^6.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dagre": "^0.7.54",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "tsx": "4.23.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
