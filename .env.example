# Optional GitHub-sync API configuration for `npm run start:api`.
# The browser and desktop apps work with local folders without this service.
# Never commit real values.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
# Optional comma-separated origins for packaged Tauri clients that use this API.
DESKTOP_APP_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
ALLOWED_GITHUB_LOGIN=your-github-login
LIBRARY_OWNER=your-github-login
LIBRARY_REPO=your-research-library
LIBRARY_BRANCH=main
# Structural metadata, claim-status manifests, and new files require a topic
# branch/PR when LIBRARY_BRANCH equals this branch. Existing prose edits remain
# directly saveable.
LIBRARY_PROTECTED_BRANCH=main
SESSION_SECRET=replace-with-a-long-random-value
INVITE_TOKEN_SECRET=replace-with-a-separate-long-random-value
LIBRARY_ACCESS_POLICY_PATH=library-access.yaml
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_INSTALLATION_ID=
# Paste PEM with literal \n characters when using a single-line .env value.
GITHUB_PRIVATE_KEY=
# In Render, prefer a Secret File and set this to its mounted path instead.
# GITHUB_PRIVATE_KEY_FILE=/etc/secrets/mathdown-github-app.pem

# Optional private desktop release feed. Most public-source builds leave this
# unconfigured and update manually.
RELEASE_OWNER=
RELEASE_REPO=
RELEASE_GITHUB_APP_ID=
RELEASE_GITHUB_INSTALLATION_ID=
# RELEASE_GITHUB_PRIVATE_KEY=
# RELEASE_GITHUB_PRIVATE_KEY_FILE=/etc/secrets/mdlyx-release-app.pem
